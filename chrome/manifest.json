{
  "manifest_version": 3,
  "name": "Kokoro Web Reader",
  "version": "1.0.0",
  "description": "Read web articles aloud using the Kokoro TTS engine.",
  "permissions": ["storage", "activeTab", "scripting"],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": {
    "default_title": "Start Kokoro Reader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}